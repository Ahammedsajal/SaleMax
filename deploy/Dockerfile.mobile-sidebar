ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.7network.base.image="${BASE_IMAGE}" org.7network.overlay.commit="${SOURCE_COMMIT}"
COPY --chown=node:node runtime/ /app/client/public/
COPY --chown=node:node deploy/patch-mobile-sidebar-shell.cjs /app/patch-mobile-sidebar-shell.cjs
RUN node /app/patch-mobile-sidebar-shell.cjs /app
