ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT=unrecorded
LABEL org.7network.overlay.commit="${SOURCE_COMMIT}"
USER root
COPY --chown=node:node client/public/mobile-workspace-tabs.css /app/client/public/mobile-workspace-tabs.css
RUN node -e "const fs=require('fs'); for(const file of ['/app/client/public/index.html','/app/client/public/pipeline/index.html']){let s=fs.readFileSync(file,'utf8');if(!s.includes('mobile-workspace-tabs.css?v=20261026-views1'))throw Error('Missing prior tabs stylesheet');fs.writeFileSync(file,s.replaceAll('mobile-workspace-tabs.css?v=20261026-views1','mobile-workspace-tabs.css?v=20261026-views2'));}"
USER node
