ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG SOURCE_COMMIT
LABEL org.7network.base.image="${BASE_IMAGE}" org.7network.overlay.commit="${SOURCE_COMMIT}"
COPY --chown=node:node modules/platform/recruitment-chat-attempt.js /app/modules/platform/recruitment-chat-attempt.js
COPY --chown=node:node modules/platform/recruitment-chat-completion.js /app/modules/platform/recruitment-chat-completion.js
COPY --chown=node:node modules/platform/recruitment-applications.js /app/modules/platform/recruitment-applications.js
RUN node --check /app/modules/platform/recruitment-chat-attempt.js && node --check /app/modules/platform/recruitment-chat-completion.js && node --check /app/modules/platform/recruitment-applications.js
