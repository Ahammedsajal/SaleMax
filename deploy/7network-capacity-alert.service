[Unit]
Description=Report 7Network host disk and inode capacity transitions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/opt/salemax/shared/ops-alerts.env
Environment=SALEMAX_CAPACITY_STATE_DIR=/var/lib/7network-ops/capacity
StateDirectory=7network-ops
StateDirectoryMode=0750
ExecStart=/opt/salemax/current/deploy/7network-capacity-alert.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/7network-ops
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
