ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT=unrecorded
LABEL org.7network.overlay.commit="${SOURCE_COMMIT}"
USER root
COPY --chown=node:node client/public/mobile-inbox-composer.js /app/client/public/mobile-inbox-composer.js
COPY --chown=node:node client/public/mobile-inbox-composer.css /app/client/public/mobile-inbox-composer.css
COPY deploy/patch-mobile-inbox-composer.cjs /tmp/patch-mobile-inbox-composer.cjs
RUN node /tmp/patch-mobile-inbox-composer.cjs
USER node
