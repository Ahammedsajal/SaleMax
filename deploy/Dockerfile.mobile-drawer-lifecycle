ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT=unrecorded
LABEL org.7network.overlay.commit="${SOURCE_COMMIT}"
USER root
COPY --chown=node:node deploy/patch-mobile-drawer-lifecycle.cjs /tmp/patch-mobile-drawer-lifecycle.cjs
RUN node /tmp/patch-mobile-drawer-lifecycle.cjs && node --check /app/client/public/training-sidebar.js
USER node
