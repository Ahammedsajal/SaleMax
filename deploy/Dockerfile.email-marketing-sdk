ARG BASE_IMAGE
FROM $BASE_IMAGE

USER root
ENV NODE_PATH=/opt/7network-email-node-modules/node_modules

COPY deploy/email-marketing-sdk/package.json deploy/email-marketing-sdk/package-lock.json /opt/7network-email-node-modules/
COPY database/config.js database/migrate-pipeline.js database/migration-runner.js /app/database/
RUN rm -rf /app/database/migrations && mkdir -p /app/database/migrations
COPY database/migrations/ /app/database/migrations/

RUN npm ci \
    --prefix /opt/7network-email-node-modules \
    --omit=dev \
    --ignore-scripts \
    --no-audit \
    --no-fund \
 && node -e "require.resolve('@aws-sdk/client-sesv2');require.resolve('@aws-sdk/client-ses')"

USER node
