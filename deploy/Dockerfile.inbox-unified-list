ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG SOURCE_COMMIT
LABEL org.7network.base.image="${BASE_IMAGE}" org.7network.overlay.commit="${SOURCE_COMMIT}" org.7network.source-commit="${SOURCE_COMMIT}"
COPY --chown=node:node client/public/inbox-groups.js /app/client/public/inbox-groups.js
COPY --chown=node:node helper/inbox/chatData.js /app/helper/inbox/chatData.js
COPY --chown=node:node routes/inbox.js /app/routes/inbox.js
COPY --chown=node:node deploy/patch-inbox-unified-list.cjs /tmp/patch-inbox-unified-list.cjs
RUN node /tmp/patch-inbox-unified-list.cjs /app && \
    node --check /app/client/public/inbox-groups.js && \
    node --check /app/helper/inbox/chatData.js && \
    node --check /app/helper/socket/index.js && \
    node --check /app/routes/inbox.js && \
    rm /tmp/patch-inbox-unified-list.cjs
