ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT=unrecorded
LABEL org.7network.overlay.commit="${SOURCE_COMMIT}"
USER root
COPY --chown=node:node client/public/phonebook-mobile.css /app/client/public/phonebook-mobile.css
RUN node -e "const fs=require('fs'),p='/app/client/public/index.html';let s=fs.readFileSync(p,'utf8');if(!s.includes('phonebook-mobile.css?v=20261026-compact1'))throw Error('Missing prior phonebook stylesheet');fs.writeFileSync(p,s.replaceAll('phonebook-mobile.css?v=20261026-compact1','phonebook-mobile.css?v=20261027-scroll1'));"
USER node
