FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG SOURCE_COMMIT=unrecorded
LABEL org.7network.base.image="${BASE_IMAGE}" org.7network.overlay.commit="${SOURCE_COMMIT}"
COPY --chown=node:node functions/function.js /app/functions/function.js
COPY --chown=node:node routes/user.js /app/routes/user.js
COPY --chown=node:node routes/broadcast.js /app/routes/broadcast.js
COPY --chown=node:node loops/campaignBeta.js /app/loops/campaignBeta.js
