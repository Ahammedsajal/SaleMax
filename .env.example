# Private values belong in local/server-owned runtime files.
LOCAL_ONLY_MODE=true
DBHOST=127.0.0.1
DBPORT=3307
DBUSER=salemax
DBPASS=
DBNAME=salemax
JWTKEY=
PORT=3010
META_APP_ID=
META_APP_SECRET=

# Enable only after reviewed identity adoption, migrations and release checks.
SALEMAX_PLATFORM_ENABLED=false
SALEMAX_PLATFORM_ORIGIN=
SALEMAX_PLATFORM_KEY_BASE64=

# Receipt email delivery is off until SMTP is configured and explicitly enabled.
SALEMAX_RECEIPT_EMAIL_ENABLED=false
SALEMAX_SMTP_HOST=
SALEMAX_SMTP_PORT=587
SALEMAX_SMTP_SECURE=false
SALEMAX_SMTP_USER=
SALEMAX_SMTP_PASS=
SALEMAX_RECEIPT_FROM=
SALEMAX_RECEIPT_WORKER_ID=
SALEMAX_RECEIPT_WORKER_INTERVAL_MS=10000

SALEMAX_ASTERISK_ALLOWED_HOSTS=
SALEMAX_ASTERISK_WS_URL=
SALEMAX_ASTERISK_MOBILE_SIP_HOST=
